# ==============================================================
# AICTE Pragyan-Drishti Environment Configuration Template
# ==============================================================

# Application Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000/api/v1

# Security & Secrets
JWT_SECRET=pragyan_drishti_jwt_super_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# PostgreSQL Relational Database
DATABASE_URL=postgresql://aicte_user:aicte_secure_password_2026@localhost:5432/aicte_db
POSTGRES_USER=aicte_user
POSTGRES_PASSWORD=aicte_secure_password_2026
POSTGRES_DB=aicte_db
POSTGRES_PORT=5432

# Redis Queue & Caching
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / S3 Private Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_DOCUMENTS=aicte-raw-documents
MINIO_BUCKET_EVIDENCE=aicte-evidence-crops

# Python AI Scrutiny Microservice (FastAPI + LangGraph)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# OCR & Forensics Config
PADDLE_OCR_LANG=en
CV_ELA_SCALE_FACTOR=15
CV_ELA_QUALITY=90

# External Authority Sandboxes
DIGILOCKER_MOCK_ENABLED=true
DIGILOCKER_CLIENT_ID=sandbox_aicte_digilocker_id
DIGILOCKER_CLIENT_SECRET=sandbox_aicte_digilocker_secret
STATE_LAND_API_MOCK_ENABLED=true
